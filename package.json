{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website - Next.js static export, Tailwind CSS, deployable to Netlify",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
